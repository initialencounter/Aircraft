{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.aircraft.app",
  "asar": true,
  "productName": "aircraft",
  "directories": {
    "output": "release/${version}"
  },
  "files": ["dist", "dist-electron"],
  "extraFiles": [
    { "from": "../firecrawl-pdfium-win-x64/bin/pdfium.dll", "to": "." },
    { "from": "../onnxruntime-win-x64-1.27.0/lib/onnxruntime.dll", "to": "." }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}_${version}_electron_x64-setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}